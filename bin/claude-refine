#!/usr/bin/env python3
"""Refine text through Claude using a named markdown template.

Reads the text to refine from stdin. Writes the rewritten text to stdout.

Usage:
    echo "some text" | claude-refine concise
    pbpaste | claude-refine professional | pbcopy

Template resolution order:
    1. $CLAUDE_REFINE_TEMPLATES_DIR
    2. ~/.config/claude-refine/templates
    3. <script dir>/../templates  (repo layout / bundled fallback)
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

USER_DIR = Path.home() / ".config" / "claude-refine" / "templates"
BUNDLED_DIR = Path(__file__).resolve().parent.parent / "templates"
CLAUDE_CMD = os.environ.get("CLAUDE_REFINE_CLAUDE_CMD", "claude")


def collect_templates() -> dict[str, Path]:
    """Return {stem: Path} merging bundled defaults with the user dir.

    User-dir files shadow bundled ones with the same stem. If
    $CLAUDE_REFINE_TEMPLATES_DIR is set, ONLY that directory is read — useful
    for testing or running against a custom set.
    """
    templates: dict[str, Path] = {}
    override = os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR")
    if override:
        override_path = Path(override).expanduser()
        if override_path.is_dir():
            for p in override_path.glob("*.md"):
                if p.stem.lower() != "readme":
                    templates[p.stem] = p
        return templates

    for source in (BUNDLED_DIR, USER_DIR):
        if not source.is_dir():
            continue
        for p in source.glob("*.md"):
            if p.stem.lower() != "readme":
                templates[p.stem] = p
    return templates


def strip_frontmatter(text: str) -> str:
    if not text.startswith("---\n"):
        return text
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return text
    return text[end + len("\n---\n"):].lstrip()


GLOBAL_PRESERVATION_RULES = (
    "GLOBAL PRESERVATION RULES (apply to every template, no exceptions):\n"
    "- Preserve every URL, markdown link (`[text](url)`), bare link, ticket "
    "reference (e.g. `#ABC-123`, `XYZ-456`), `@mention`, GitHub-style `#1234`, "
    "and file path from the input EXACTLY as written — character-for-character.\n"
    "- Never drop, summarize, paraphrase, or shorten any of the above. If a "
    "URL is long, keep it long. If a link's display text is awkward, keep it.\n"
    "- If you cannot fit a link naturally inline, keep it in a 'Links', "
    "'References', or 'Notes' section at the bottom of your output — but "
    "never silently remove it.\n"
)


def build_prompt(template_body: str, input_text: str) -> str:
    if "{{INPUT}}" in template_body:
        return (
            f"{GLOBAL_PRESERVATION_RULES}\n"
            f"{template_body.replace('{{INPUT}}', input_text)}"
        )
    return (
        f"{template_body.strip()}\n\n"
        f"{GLOBAL_PRESERVATION_RULES}\n"
        f"<text-to-refine>\n{input_text}\n</text-to-refine>\n\n"
        "Output ONLY the rewritten text. No preamble, no markdown code fences, "
        "no commentary, no quotation marks around the output."
    )


def main() -> int:
    if len(sys.argv) < 2:
        sys.stderr.write(
            "Usage: claude-refine <template-name>  (reads input from stdin)\n"
        )
        return 64

    template_name = sys.argv[1]
    templates = collect_templates()
    template_file = templates.get(template_name)
    if template_file is None:
        available = ", ".join(sorted(templates.keys())) or "(none — no templates found)"
        sys.stderr.write(
            f"Template not found: {template_name}\n"
            f"Searched: {BUNDLED_DIR}, {USER_DIR}\n"
            f"Available: {available}\n"
        )
        return 66

    input_text = sys.stdin.read().strip()
    if not input_text:
        sys.stderr.write("No input text on stdin\n")
        return 65

    template_body = strip_frontmatter(template_file.read_text())
    final_prompt = build_prompt(template_body, input_text)

    try:
        result = subprocess.run(
            [CLAUDE_CMD, "-p", "--exclude-dynamic-system-prompt-sections"],
            input=final_prompt,
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        sys.stderr.write(
            f"Could not run '{CLAUDE_CMD}'. Is the Claude CLI installed and on PATH?\n"
        )
        return 127

    if result.returncode != 0:
        sys.stderr.write(result.stderr or "claude exited non-zero\n")
        return result.returncode

    sys.stdout.write(result.stdout.rstrip() + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
