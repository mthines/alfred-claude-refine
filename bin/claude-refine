#!/usr/bin/env python3
"""Refine text through Claude using a named markdown template OR a custom instruction.

Reads the text to refine from stdin. Writes the rewritten text to stdout.

Usage:
    echo "some text" | claude-refine concise
    echo "some text" | claude-refine --instruction "make it more focused on what it's trying to solve"
    pbpaste | claude-refine professional | pbcopy

Templates live in ~/.config/claude-refine/templates (single source of truth,
seeded from the repo by install.sh). Override with $CLAUDE_REFINE_TEMPLATES_DIR.
"""
from __future__ import annotations

import os
import subprocess
import sys
from pathlib import Path

USER_DIR = Path.home() / ".config" / "claude-refine" / "templates"
CLAUDE_CMD = os.environ.get("CLAUDE_REFINE_CLAUDE_CMD", "claude")


def collect_templates() -> dict[str, Path]:
    """Return {stem: Path} for every template in the user dir.

    The user dir is the single source of truth — `install.sh` seeds it from
    the repo's `templates/` (by copy or symlink, depending on --dev). Set
    `$CLAUDE_REFINE_TEMPLATES_DIR` to override and read from somewhere else.
    """
    source = Path(os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR", str(USER_DIR))).expanduser()
    templates: dict[str, Path] = {}
    if source.is_dir():
        for p in source.glob("*.md"):
            if p.stem.lower() != "readme":
                templates[p.stem] = p
    return templates


def strip_frontmatter(text: str) -> str:
    if not text.startswith("---\n"):
        return text
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return text
    return text[end + len("\n---\n"):].lstrip()


GLOBAL_PRESERVATION_RULES = (
    "GLOBAL PRESERVATION RULES (apply to every template, no exceptions):\n"
    "\n"
    "Markdown:\n"
    "- Preserve any markdown structure already in the input — headings (#, ##), "
    "lists (-, *, 1.), code blocks (```), inline code (`), blockquotes (>), "
    "bold (**), italic (*), tables. Do NOT strip formatting when reshaping text.\n"
    "- If the input has no markdown but the rewritten output would naturally "
    "benefit (multiple distinct ideas, parallel items, code references), use "
    "markdown — it renders cleanly in Linear, Slack, GitHub, and most "
    "destinations the user is likely pasting into.\n"
    "\n"
    "Links, references, mentions:\n"
    "- Preserve every URL, markdown link (`[text](url)`), bare link, ticket "
    "reference (e.g. `#ABC-123`, `XYZ-456`), `@mention`, GitHub-style `#1234`, "
    "and file path from the input EXACTLY as written — character-for-character.\n"
    "- Never drop, summarize, paraphrase, or shorten any of the above. If a "
    "URL is long, keep it long. If a link's display text is awkward, keep it.\n"
    "- If you cannot fit a link naturally inline, keep it in a 'Links', "
    "'References', or 'Notes' section at the bottom of your output — but "
    "never silently remove it.\n"
)


def build_prompt(template_body: str, input_text: str) -> str:
    if "{{INPUT}}" in template_body:
        return (
            f"{GLOBAL_PRESERVATION_RULES}\n"
            f"{template_body.replace('{{INPUT}}', input_text)}"
        )
    return (
        f"{template_body.strip()}\n\n"
        f"{GLOBAL_PRESERVATION_RULES}\n"
        f"<text-to-refine>\n{input_text}\n</text-to-refine>\n\n"
        "Output ONLY the rewritten text. No preamble, no markdown code fences, "
        "no commentary, no quotation marks around the output."
    )


CUSTOM_INSTRUCTION_FRAME = (
    "You are an editor. Apply the following user instruction to the text inside "
    "`<text-to-refine>`. Preserve meaning, structure, tone, and length unless "
    "the instruction explicitly asks you to change one of those.\n\n"
    "User instruction:\n{instruction}"
)


def main() -> int:
    if len(sys.argv) < 2:
        sys.stderr.write(
            "Usage:\n"
            "  claude-refine <template-name>             (reads input from stdin)\n"
            "  claude-refine --instruction \"<text>\"      (custom one-off instruction)\n"
        )
        return 64

    if sys.argv[1] == "--instruction":
        if len(sys.argv) < 3:
            sys.stderr.write("--instruction requires a non-empty value\n")
            return 64
        instruction = sys.argv[2].strip()
        if not instruction:
            sys.stderr.write("--instruction value is empty\n")
            return 64
        template_body = CUSTOM_INSTRUCTION_FRAME.format(instruction=instruction)
    else:
        template_name = sys.argv[1]
        templates = collect_templates()
        template_file = templates.get(template_name)
        if template_file is None:
            available = ", ".join(sorted(templates.keys())) or "(none — no templates found)"
            searched = os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR") or str(USER_DIR)
            sys.stderr.write(
                f"Template not found: {template_name}\n"
                f"Searched: {searched}\n"
                f"Available: {available}\n"
            )
            return 66
        template_body = strip_frontmatter(template_file.read_text())

    input_text = sys.stdin.read().strip()
    if not input_text:
        sys.stderr.write("No input text on stdin\n")
        return 65

    final_prompt = build_prompt(template_body, input_text)

    try:
        result = subprocess.run(
            [
                CLAUDE_CMD,
                "-p",
                "--exclude-dynamic-system-prompt-sections",
                # Disable all hooks for this headless run. Stop hooks (e.g. a
                # memory/retrospective hook that blocks and injects a
                # "decide whether to record a lesson" turn) otherwise hijack
                # the final assistant message, so refine would emit the hook's
                # message instead of the rewritten text. Unlike `--bare`, this
                # keeps normal OAuth/keychain auth working.
                "--settings",
                '{"disableAllHooks": true}',
            ],
            input=final_prompt,
            capture_output=True,
            text=True,
            check=False,
        )
    except FileNotFoundError:
        sys.stderr.write(
            f"Could not run '{CLAUDE_CMD}'. Is the Claude CLI installed and on PATH?\n"
        )
        return 127

    if result.returncode != 0:
        sys.stderr.write(result.stderr or "claude exited non-zero\n")
        return result.returncode

    sys.stdout.write(result.stdout.rstrip() + "\n")
    return 0


if __name__ == "__main__":
    sys.exit(main())
