#!/usr/bin/env python3
"""List available claude-refine templates as Alfred Script Filter JSON.

Reads optional query string from argv[1] for filtering by title/description/stem.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

DEFAULT_USER_DIR = Path.home() / ".config" / "claude-refine" / "templates"
BUNDLED_DIR = Path(__file__).resolve().parent.parent / "templates"


def resolve_templates_dir() -> Path:
    override = os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR")
    if override:
        return Path(override).expanduser()
    if DEFAULT_USER_DIR.is_dir():
        return DEFAULT_USER_DIR
    return BUNDLED_DIR


def parse_frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---\n"):
        return {}
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return {}
    meta: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        meta[key.strip()] = value.strip().strip('"').strip("'")
    return meta


def main() -> int:
    query = (sys.argv[1].strip().lower() if len(sys.argv) > 1 else "")
    templates_dir = resolve_templates_dir()

    if not templates_dir.is_dir():
        print(json.dumps({
            "items": [{
                "title": "No templates directory found",
                "subtitle": f"Expected {templates_dir} — run install.sh from the repo",
                "valid": False,
            }]
        }))
        return 0

    items: list[dict] = []
    for path in sorted(templates_dir.glob("*.md")):
        if path.stem.lower() == "readme":
            continue
        try:
            meta = parse_frontmatter(path.read_text())
        except OSError:
            continue

        title = meta.get("title") or path.stem.replace("-", " ").title()
        subtitle = meta.get("description", "")
        haystack = f"{title} {subtitle} {path.stem}".lower()
        if query and query not in haystack:
            continue

        items.append({
            "uid": path.stem,
            "title": title,
            "subtitle": subtitle,
            "arg": path.stem,
            "autocomplete": path.stem,
            "match": f"{title} {subtitle} {path.stem}",
        })

    if not items:
        items.append({
            "title": "No matching templates",
            "subtitle": f"Add a .md file to {templates_dir}",
            "valid": False,
        })

    print(json.dumps({"items": items}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
