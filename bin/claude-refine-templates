#!/usr/bin/env python3
"""List available claude-refine templates as Alfred Script Filter JSON.

Reads only from ~/.config/claude-refine/templates — install.sh is responsible
for seeding it from the repo (by copy or symlink, depending on --dev).
Override with $CLAUDE_REFINE_TEMPLATES_DIR to read from a different directory.

Reads optional query string from argv[1] for case-insensitive filtering by
title / description / stem.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

USER_DIR = Path.home() / ".config" / "claude-refine" / "templates"


def collect_templates() -> dict[str, Path]:
    source = Path(os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR", str(USER_DIR))).expanduser()
    templates: dict[str, Path] = {}
    if source.is_dir():
        for p in source.glob("*.md"):
            if p.stem.lower() != "readme":
                templates[p.stem] = p
    return templates


def parse_frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---\n"):
        return {}
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return {}
    meta: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        meta[key.strip()] = value.strip().strip('"').strip("'")
    return meta


def custom_instruction_item(instruction: str) -> dict:
    """Build the Script Filter item for a custom one-off instruction.

    Invalid (not selectable) when the instruction text is empty, so the user
    sees a hint instead of an actionable item that would do nothing useful.
    """
    has_text = bool(instruction)
    subtitle = (
        f"Refine with this instruction: \"{instruction}\""
        if has_text
        else "Type your refinement instruction after the dash…"
    )
    return {
        "uid": "__custom__",
        "title": "Custom instruction",
        "subtitle": subtitle,
        "arg": "__custom__",
        "valid": has_text,
        "variables": {
            "paste_mode": "background",
            "custom_instruction": instruction,
        },
        "mods": {
            "cmd": {
                "arg": "__custom__",
                "subtitle": "⌘↩ Paste directly into the active app (blocking)",
                "valid": has_text,
                "variables": {
                    "paste_mode": "foreground",
                    "custom_instruction": instruction,
                },
            }
        },
    }


def main() -> int:
    raw_query = sys.argv[1] if len(sys.argv) > 1 else ""

    debug_path = os.environ.get("CLAUDE_REFINE_DEBUG_LOG")
    if debug_path:
        try:
            with open(debug_path, "a") as f:
                f.write(
                    f"argv={sys.argv!r} raw_query={raw_query!r} "
                    f"cwd={os.getcwd()!r} env_query={os.environ.get('query')!r}\n"
                )
        except OSError:
            pass

    # Custom-instruction mode: `rw - <free-form instruction>`
    if raw_query.lstrip().startswith("-"):
        instruction = raw_query.lstrip()[1:].strip()
        print(json.dumps({"items": [custom_instruction_item(instruction)]}))
        return 0

    query = raw_query.strip().lower()
    templates = collect_templates()

    if not templates:
        searched = os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR") or str(USER_DIR)
        print(json.dumps({
            "items": [{
                "title": "No templates found",
                "subtitle": f"Run install.sh from the repo to seed {searched}",
                "valid": False,
            }]
        }))
        return 0

    items: list[dict] = []
    for stem in sorted(templates.keys()):
        path = templates[stem]
        try:
            meta = parse_frontmatter(path.read_text())
        except OSError:
            continue

        title = meta.get("title") or stem.replace("-", " ").title()
        subtitle = meta.get("description", "")
        haystack = f"{title} {subtitle} {stem}".lower()
        if query and query not in haystack:
            continue

        items.append({
            "uid": stem,
            "title": title,
            "subtitle": subtitle,
            "arg": stem,
            "autocomplete": stem,
            "match": f"{title} {subtitle} {stem}",
            "variables": {"paste_mode": "background"},
            "mods": {
                "cmd": {
                    "arg": stem,
                    "subtitle": "⌘↩ Paste directly into the active app (blocking)",
                    "variables": {"paste_mode": "foreground"},
                }
            },
        })

    # No template matched — if the user typed something, treat it as a
    # free-form custom instruction. (The explicit `- prefix` shortcut handled
    # above always shows ONLY the custom item; this branch is the fallback for
    # users who just type their instruction without a leading dash.)
    if not items:
        if raw_query.strip():
            items.append(custom_instruction_item(raw_query.strip()))
        else:
            items.append({
                "title": "No templates found",
                "subtitle": f"Drop a .md file into {USER_DIR} or the repo's templates/",
                "valid": False,
            })

    print(json.dumps({"items": items}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
