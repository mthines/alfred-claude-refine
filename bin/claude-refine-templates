#!/usr/bin/env python3
"""List available claude-refine templates as Alfred Script Filter JSON.

Templates are merged from two locations (user wins on conflicts):
    - Bundled: <script dir>/../templates   (the repo's templates)
    - User:    ~/.config/claude-refine/templates

Set $CLAUDE_REFINE_TEMPLATES_DIR to read ONLY from a single custom directory.

Reads optional query string from argv[1] for case-insensitive filtering by
title / description / stem.
"""
from __future__ import annotations

import json
import os
import sys
from pathlib import Path

USER_DIR = Path.home() / ".config" / "claude-refine" / "templates"
BUNDLED_DIR = Path(__file__).resolve().parent.parent / "templates"


def collect_templates() -> dict[str, Path]:
    templates: dict[str, Path] = {}
    override = os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR")
    if override:
        override_path = Path(override).expanduser()
        if override_path.is_dir():
            for p in override_path.glob("*.md"):
                if p.stem.lower() != "readme":
                    templates[p.stem] = p
        return templates

    for source in (BUNDLED_DIR, USER_DIR):
        if not source.is_dir():
            continue
        for p in source.glob("*.md"):
            if p.stem.lower() != "readme":
                templates[p.stem] = p
    return templates


def parse_frontmatter(text: str) -> dict[str, str]:
    if not text.startswith("---\n"):
        return {}
    try:
        end = text.index("\n---\n", 4)
    except ValueError:
        return {}
    meta: dict[str, str] = {}
    for line in text[4:end].splitlines():
        if ":" not in line:
            continue
        key, _, value = line.partition(":")
        meta[key.strip()] = value.strip().strip('"').strip("'")
    return meta


def main() -> int:
    raw_query = sys.argv[1] if len(sys.argv) > 1 else ""
    query = raw_query.strip().lower()

    debug_path = os.environ.get("CLAUDE_REFINE_DEBUG_LOG")
    if debug_path:
        try:
            with open(debug_path, "a") as f:
                f.write(
                    f"argv={sys.argv!r} raw_query={raw_query!r} query={query!r} "
                    f"cwd={os.getcwd()!r} env_query={os.environ.get('query')!r}\n"
                )
        except OSError:
            pass

    templates = collect_templates()

    if not templates:
        searched = (
            os.environ.get("CLAUDE_REFINE_TEMPLATES_DIR")
            or f"{BUNDLED_DIR} and {USER_DIR}"
        )
        print(json.dumps({
            "items": [{
                "title": "No templates found",
                "subtitle": f"Searched: {searched}",
                "valid": False,
            }]
        }))
        return 0

    items: list[dict] = []
    for stem in sorted(templates.keys()):
        path = templates[stem]
        try:
            meta = parse_frontmatter(path.read_text())
        except OSError:
            continue

        title = meta.get("title") or stem.replace("-", " ").title()
        subtitle = meta.get("description", "")
        haystack = f"{title} {subtitle} {stem}".lower()
        if query and query not in haystack:
            continue

        items.append({
            "uid": stem,
            "title": title,
            "subtitle": subtitle,
            "arg": stem,
            "autocomplete": stem,
            "match": f"{title} {subtitle} {stem}",
            "variables": {"paste_mode": "foreground"},
            "mods": {
                "cmd": {
                    "arg": stem,
                    "subtitle": "⌘↩ Background — copy to clipboard + notify, no auto-paste",
                    "variables": {"paste_mode": "background"},
                }
            },
        })

    if not items:
        items.append({
            "title": f"No templates matching '{query}'",
            "subtitle": f"Type to filter or drop a .md file into {USER_DIR}",
            "valid": False,
        })

    print(json.dumps({"items": items}))
    return 0


if __name__ == "__main__":
    sys.exit(main())
